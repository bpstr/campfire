#!/usr/bin/env bash
set -euo pipefail
source /opt/campfire/lib.sh
current="${CAMPFIRE_CURRENT_AGENT:-}"
while IFS='|' read -r name adapter; do
  if participant_enabled "$name" "$adapter"; then
    [[ "$name" == "$current" ]] && state=self || state=available
    if participant_manually_verified "$name"; then state="$state (manual)"; fi
  elif participant_installed "$adapter"; then
    state=login-required
  else
    state=not-installed
  fi
  printf '%-10s %s\n' "$name" "$state"
done < <(participant_registry)
