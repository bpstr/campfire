#!/usr/bin/env bash
set -euo pipefail
source /opt/campfire/lib.sh
current="${CAMPFIRE_CURRENT_AGENT:-}"
while IFS='|' read -r name env_var adapter; do
  if participant_enabled "$env_var" && participant_installed "$adapter"; then
    [[ "$name" == "$current" ]] && state=self || state=available
    printf '%-10s %s\n' "$name" "$state"
  fi
done < <(participant_registry)
