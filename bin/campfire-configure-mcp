#!/usr/bin/env bash
set -euo pipefail
case "${CAMPFIRE_COMMUNICATION_ENABLED:-false}" in
  1|true|TRUE|yes|YES|on|ON) ;;
  *) exit 0 ;;
esac

mkdir -p "$CODEX_HOME" "$HOME/.gemini" "$GROK_HOME" "$KIMI_CODE_HOME" "$XDG_CONFIG_HOME/muse"

# Merge Campfire into JSON settings without deleting unrelated user settings.
tmp="$(mktemp)"
if [[ -f "$HOME/.gemini/settings.json" ]]; then
  jq -s '.[0] * .[1]' "$HOME/.gemini/settings.json" /opt/campfire/mcp/providers/gemini.json > "$tmp"
else
  cp /opt/campfire/mcp/providers/gemini.json "$tmp"
fi
mv "$tmp" "$HOME/.gemini/settings.json"

tmp="$(mktemp)"
if [[ -f "$XDG_CONFIG_HOME/muse/settings.json" ]]; then
  jq -s '.[0] * .[1]' "$XDG_CONFIG_HOME/muse/settings.json" /opt/campfire/mcp/providers/muse.json > "$tmp"
else
  cp /opt/campfire/mcp/providers/muse.json "$tmp"
fi
mv "$tmp" "$XDG_CONFIG_HOME/muse/settings.json"

# Kimi has a dedicated MCP declaration file.
cp /opt/campfire/mcp/providers/kimi.json "$KIMI_CODE_HOME/mcp.json"

# TOML-backed clients: append Campfire only when it is not already declared.
touch "$CODEX_HOME/config.toml" "$GROK_HOME/config.toml"
grep -q '^\[mcp_servers\.campfire\]' "$CODEX_HOME/config.toml" || { printf '\n' >> "$CODEX_HOME/config.toml"; cat /opt/campfire/mcp/providers/codex.toml >> "$CODEX_HOME/config.toml"; }
grep -q '^\[mcp_servers\.campfire\]' "$GROK_HOME/config.toml" || { printf '\n' >> "$GROK_HOME/config.toml"; cat /opt/campfire/mcp/providers/grok.toml >> "$GROK_HOME/config.toml"; }
