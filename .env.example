# Campfire prefers each official CLI's native account/subscription login.
# Authenticate the CLIs once inside the persistent /home/campfire volume.
#
# Optional enterprise token for `codex login --with-access-token` during setup.
# Setting it here alone does not authenticate `codex exec`.
CODEX_ACCESS_TOKEN=

# Optional Claude subscription token created with `claude setup-token`.
# Leave empty when using native /login inside the persistent home.
CLAUDE_CODE_OAUTH_TOKEN=

# The first line of workspace/.campfire/next selects the initial agent.
CAMPFIRE_MAX_TURNS=6
CAMPFIRE_TURN_TIMEOUT=1800
CAMPFIRE_UNAVAILABLE_POLICY=wait
CAMPFIRE_WAIT_SECONDS=900

CAMPFIRE_COMMUNICATION_ENABLED=false
CAMPFIRE_ASK_TIMEOUT=1800

# Human-readable CLI output is the default. Set true to retain each CLI's raw
# JSON event stream in the terminal and per-run logs where supported.
CAMPFIRE_JSON_OUTPUT=false

# Optional comma-separated CLI names verified manually by you. This bypasses
# Campfire's local credential detection for those names; it does not validate
# the provider again or change which account/billing method the CLI uses.
CAMPFIRE_MANUALLY_VERIFIED_AGENTS=

# API keys are intentionally omitted. Provider API/PAYG authentication is a
# compatibility fallback, not Campfire's normal or recommended setup.
