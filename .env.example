# Campfire prefers each official CLI's native account/subscription login.
# Authenticate the CLIs once inside the persistent /home/campfire volume.
#
# Codex automation may optionally receive a ChatGPT-managed Codex access token.
CODEX_ACCESS_TOKEN=

CAMPFIRE_INITIAL_AGENT=
CAMPFIRE_MAX_TURNS=6
CAMPFIRE_TURN_TIMEOUT=1800
CAMPFIRE_UNAVAILABLE_POLICY=wait
CAMPFIRE_WAIT_SECONDS=900

CAMPFIRE_COMMUNICATION_ENABLED=false
CAMPFIRE_ASK_TIMEOUT=1800

# API keys are intentionally omitted. Provider API/PAYG authentication is a
# compatibility fallback, not Campfire's normal or recommended setup.
